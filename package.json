    "type": "module",
    "main": "index.js",
    "scripts": {
        "dev": "NODE_ENV=dev tsx watch src/index.ts",
        "dev:qa": "NODE_ENV=qa tsx watch src/index.ts",
        "start": "NODE_ENV=production node --loader tsx src/index.ts",
        "start:qa": "NODE_ENV=qa node --loader tsx src/index.ts",
        "test:auth": "tsx test-auth.ts",
        "lint": "eslint . --ext .ts,.js",
        "lint:fix": "eslint . --ext .ts,.js --fix",
        "format": "prettier --write \"src/**/*.{ts,js,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
        "type-check": "tsc --noEmit",
        "check": "pnpm type-check && pnpm lint && pnpm format:check"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@10.19.0",
    "dependencies": {
        "better-auth": "^1.3.33",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "express-mongo-sanitize": "^2.2.0",
        "mongoose": "^8.19.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.38.0",
        "@tsconfig/node24": "^24.0.1",
        "@types/cors": "^2.8.19",
        "@types/eslint__js": "^9.14.0",
        "@types/express": "^5.0.5",
        "@types/mongoose": "^5.11.97",
        "@types/node": "^24.9.2",
        "eslint": "^9.38.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "nodemon": "^3.1.10",
        "prettier": "^3.6.2",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.2"
    }
