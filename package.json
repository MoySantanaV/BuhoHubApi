{
    "name": "buho-hub-api",
    "version": "1.0.0",
    "description": "",
    "type": "module",
    "main": "index.js",
    "pnpm": {
        "overrides": {
            "@types/express": "^4.17.21",
            "@types/express-serve-static-core": "^4.19.6"
        },
        "onlyBuiltDependencies": [
            "bcrypt"
        ]
    },
    "scripts": {
        "dev": "NODE_ENV=dev tsx watch src/index.ts",
        "dev:qa": "NODE_ENV=qa tsx watch src/index.ts",
        "start": "NODE_ENV=production node --loader tsx src/index.ts",
        "start:qa": "NODE_ENV=qa node --loader tsx src/index.ts",
        "build": "tsc",
        "lint": "eslint . --ext .ts,.js",
        "lint:fix": "eslint . --ext .ts,.js --fix",
        "format": "prettier --write \"src/**/*.{ts,js,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
        "type-check": "tsc --noEmit",
        "migrate:profiles": "tsx scripts/migrateProfiles.ts",
        "migrate:accounts": "tsx scripts/migrateAccounts.ts",
        "check": "pnpm type-check && pnpm lint && pnpm format:check && pnpm test",
        "test": "node --import tsx --test 'src/**/*.test.ts'",
        "test:watch": "node --import tsx --test --watch 'src/**/*.test.ts'",
        "test:coverage": "node --import tsx --test --experimental-test-coverage 'src/**/*.test.ts'"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@10.19.0",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "connect-mongo": "^5.1.0",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "expo-dev-client": "^6.0.20",
        "express": "^5.1.0",
        "express-mongo-sanitize": "^2.2.0",
        "express-rate-limit": "^8.7.0",
        "express-session": "^1.18.2",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.19.2",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.38.0",
        "@tsconfig/node24": "^24.0.1",
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.19",
        "@types/eslint__js": "^9.14.0",
        "@types/express": "^4.17.21",
        "@types/express-session": "^1.18.2",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/mongoose": "^5.11.97",
        "@types/node": "^24.9.2",
        "@types/passport": "^1.0.17",
        "@types/passport-google-oauth20": "^2.0.17",
        "eslint": "^9.38.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "mongodb-memory-server": "^11.3.0",
        "nodemon": "^3.1.10",
        "prettier": "^3.6.2",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.2"
    }
}
