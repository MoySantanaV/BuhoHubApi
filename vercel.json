{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "builds": [
        {
            "src": "api/index.ts",
            "use": "@vercel/node",
            "config": {
                "maxLambdaSize": "50mb"
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/api"
        }
    ],
    "env": {
        "TSC_COMPILE_ON_ERROR": "true",
        "TS_NODE_TRANSPILE_ONLY": "true"
    }
}
